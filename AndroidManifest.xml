<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.fakhrads.bypasscharging">

    <!-- Charging control state lives in LineageSettings.System -->
    <uses-permission android:name="lineageos.permission.WRITE_SETTINGS" />
    <!-- LineageSettingsProvider checks it (or the WRITE_SETTINGS appop) on every insert -->
    <uses-permission android:name="lineageos.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Persistent (allowed for system apps) and direct boot aware, so cool charging follows the
         battery temperature from boot on -->
    <application
        android:name=".BypassChargingApp"
        android:persistent="true"
        android:directBootAware="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_bypass_charging"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name=".BypassTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_bypass_charging"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Turns bypass off after every boot, before the first unlock, and sets the fast charging
             limit again (the kernel forgets it on reboot) -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
